# Example environment file for the backend application.
# Copy this file to `backend/.env`, then fill in each value with your local or deployment configuration.
# Do not commit the real `.env` file because it contains secrets and private service credentials.

# Runtime environment for the backend process.
# Use `development` locally and `production` on the deployed server.
NODE_ENV=

# Port used by the Express backend server.
PORT=

# MongoDB connection string used by the backend and Better Auth.
# Example: mongodb://localhost:27017/multivendor
MONGO_URI=

# Secret used by Better Auth to sign and verify auth cookies and tokens.
# Generate a strong value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public base URL of the backend auth server.
# Local example: http://localhost:5001
BETTER_AUTH_URL=

# Public base URL of the frontend allowed by CORS and trusted origins.
# Local example: http://localhost:3000
FRONTEND_URL=

# Google OAuth client ID used for Google sign-in.
GOOGLE_CLIENT_ID=

# Google OAuth client secret paired with the client ID above.
GOOGLE_CLIENT_SECRET=

# Google OAuth refresh token used by the mail / OAuth integration.
GOOGLE_REFRESH_TOKEN=

# Enables or disables email verification after sign-up.
# Use `false` for local development if SMTP is not configured yet.
REQUIRE_EMAIL_VERIFICATION=

# App password used to send emails through the configured mailbox.
EMAIL_APP_PASSWORD=

# Sender email address used for platform emails.
# This must match the mailbox or OAuth account used for email sending.
EMAIL_FROM=

# Cloudinary cloud name used for image upload and delivery.
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key for authenticated upload operations.
CLOUDINARY_API_KEY=

# Cloudinary API secret paired with the API key above.
CLOUDINARY_API_SECRET=
