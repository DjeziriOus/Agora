              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "const shop = j.shop || j;",
                  "pm.test('Shop id returned', () => pm.expect(shop.id || shop._id).to.be.ok);",
